# Copy to bamboozled.env (git-ignored). scripts/find-host.sh writes the first block; fill in the rest.
BAMBOOZLED_ENV_NAME=prod
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=ap-southeast-2
BAMBOOZLED_ALERT_EMAIL=
BAMBOOZLED_BUDGET_USD=10
# The public application id (also baked into the web bundle); never a secret
BAMBOOZLED_DISCORD_APP_ID=
# Must equal the origin_verify SSM parameter (scripts/put-secrets.sh stores it). Generate: openssl rand -hex 24
BAMBOOZLED_ORIGIN_VERIFY=
# linux/arm64 for t4g (Graviton) hosts, linux/amd64 for t3 and similar
BAMBOOZLED_PLATFORM=linux/arm64
# written by scripts/find-host.sh:
BAMBOOZLED_HOST_TAG_KEY=
BAMBOOZLED_HOST_TAG_VALUE=
BAMBOOZLED_HOST_ROLE_NAME=
BAMBOOZLED_HOST_VPC_ID=
BAMBOOZLED_HOST_SUBNET_ID=
BAMBOOZLED_HOST_AZ=
BAMBOOZLED_CLOUDFRONT_PREFIX_LIST_ID=
