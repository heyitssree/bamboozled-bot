# =============================================================================
# Bamboozled - environment variables (single file for the bot, the Activity
# backend and the Activity frontend). Copy to .env and fill in.
# Lines starting with # are comments. Never commit the real .env file.
#
# Everything lives in ONE Discord application. Create it at
#   https://discord.com/developers/applications
# =============================================================================

# ---- 1. SLASH-COMMAND BOT (required) ---------------------------------------

# Bot token.
# Where: Developer Portal -> your app -> Bot -> Reset Token (shown once, copy it)
DISCORD_TOKEN=your-bot-token

# ---- 2. DISCORD ACTIVITY (optional - only for /bamboozled-activity) ---------

# Application ID of the same Discord app. Used for the three names below, which
# must all hold the SAME value.
# Where: Developer Portal -> your app -> General Information -> Application ID
# DISCORD_APPLICATION_ID is read by the bot
DISCORD_APPLICATION_ID=your-application-id
# DISCORD_CLIENT_ID is read by the Activity backend
DISCORD_CLIENT_ID=your-application-id
# VITE_DISCORD_CLIENT_ID is read by the Activity frontend at build time
VITE_DISCORD_CLIENT_ID=your-application-id

# OAuth2 client secret of the same app (backend only, keep private).
# Where: Developer Portal -> your app -> OAuth2 -> Client Secret -> Reset Secret
DISCORD_CLIENT_SECRET=your-client-secret

# Public base URL of the Activity backend, as seen by the BOT (no trailing slash).
# Local dev: http://localhost:8000    Production: your hosted backend, e.g. https://bamboozled-api.example.com
ACTIVITY_BACKEND_URL=http://localhost:8000

# Backend URL as seen by the Activity running INSIDE Discord (build time).
# Websocket scheme. Local dev: ws://localhost:8000
# Production: wss://<your-backend-host>  (or via a Discord URL Mapping, see README)
VITE_BACKEND_URL=ws://localhost:8000

# Where the Activity backend stores its SQLite DB (default shown).
DB_PATH=data/bamboozled_activity.db

# ---- 3. BOLI POINTS INTEGRATION WITH NAVI (optional) ------------------------
# Leave all three empty to run Bamboozled on its own; no points are shared.

# (a) Same-machine mode: absolute path to Navi's SQLite file. The bot writes
#     Boli awards straight into it at the end of each game.
# Where: Navi's DB_PATH, default <navi-bot>/data/navi.db
NAVI_DB_PATH=

# (b) Activity mode: Navi's HTTP API. Needs Navi's API reachable from the backend.
# Where: the host/IP and API_SERVER_PORT (default 8080) of your Navi bot
BOT_INTERNAL_API_URL=http://localhost:8080
# Shared secret. Must match BOT_INTERNAL_SECRET in Navi's .env.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_INTERNAL_SECRET=
