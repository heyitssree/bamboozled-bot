[Unit]
Description=Bamboozled - Chaos Trivia Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace YOUR_USER and the path with where you cloned bamboozled-bot
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/bamboozled-bot
EnvironmentFile=/home/YOUR_USER/bamboozled-bot/.env
ExecStart=/home/YOUR_USER/bamboozled-bot/.venv/bin/python bot.py
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/YOUR_USER/bamboozled-bot/logs/bot.log
StandardError=append:/home/YOUR_USER/bamboozled-bot/logs/bot.log

[Install]
WantedBy=multi-user.target
